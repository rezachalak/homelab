{
  "Dhcp4": {
    // Relay-only server. The GWN7670 AP runs its SSID in NAT mode and relays its
    // clients' DHCP requests here (unicast to 192.168.25.25:67). The A1 router
    // keeps serving DHCP on 192.168.25.0/24 - Kea has no subnet there, so it
    // never answers LAN broadcasts and the two servers cannot collide.
    "interfaces-config": {
      "interfaces": [ "ens18" ],
      // Relayed traffic is plain unicast UDP, so no raw socket (and no NET_RAW).
      "dhcp-socket-type": "udp",
      "outbound-interface": "use-routing",
      "service-sockets-max-retries": 30,
      "service-sockets-retry-wait-time": 2000
    },

    "authoritative": true,

    "lease-database": {
      "type": "memfile",
      "persist": true,
      "name": "/var/lib/kea/kea-leases4.csv",
      "lfc-interval": 3600
    },

    // Local unix socket only - no HTTP/REST control endpoint is exposed.
    "control-sockets": [
      { "socket-type": "unix", "socket-name": "/var/run/kea/kea4-ctrl-socket" }
    ],

    "valid-lifetime": 43200,
    "renew-timer": 21600,
    "rebind-timer": 37800,

    "option-data": [
      { "name": "domain-name-servers", "data": "192.168.25.100, 9.9.9.9" },
      { "name": "domain-name", "data": "rezoreyz.lan" },
      { "name": "domain-search", "data": "rezoreyz.lan" }
    ],

    "subnet4": [
      {
        // The AP's NAT pool. Requests arrive with giaddr 10.1.0.1 and are
        // matched to this subnet by it.
        "id": 1,
        "subnet": "10.1.0.0/24",
        // Also accept the relay identifying itself by its LAN address.
        "relay": { "ip-addresses": [ "192.168.25.3" ] },
        "pools": [ { "pool": "10.1.0.100 - 10.1.0.250" } ],
        "option-data": [
          { "name": "routers", "data": "10.1.0.1" }
        ]
      }
    ],

    "loggers": [
      {
        "name": "kea-dhcp4",
        "output-options": [ { "output": "stdout", "pattern": "%-5p %m\n" } ],
        "severity": "INFO"
      }
    ]
  }
}
